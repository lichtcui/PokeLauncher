<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本地 HTTP 服务与 GitHub 下载都走 socket，回环地址同样需要 INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      下载资源包的前台服务（dataSync）。三个权限缺一不可：
      - FOREGROUND_SERVICE：进入前台的基本权限；
      - FOREGROUND_SERVICE_DATA_SYNC：targetSdk 35 起 dataSync 类型必须单独声明；
      - POST_NOTIFICATIONS：API 33+ 的通知权限，打靶页发起下载前用运行时弹框申请
        （没有它前台服务通知仍会显示，但「下载完成/失败」的普通通知会被系统丢弃）。
      WAKE_LOCK：507MB 下载跨屏熄灭时要继续跑（带 60 分钟上限的 partial wake lock）。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      应用内自更新：下载 APK 后交给系统安装器。
      这是一个**普通权限**（用户不可单独授权），真正把关的是系统设置里的「安装未知应用」
      开关（运行时用 PackageManager.canRequestPackageInstalls() 查、用
      Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES 引导）。
      仅用于自更新，不装任何第三方包——上架时在隐私说明里写清楚这一点。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PokeLauncher"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PokeLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          下载前台服务。stopWithTask=false：用户从最近任务里划掉 App 后下载继续跑
          （进程被系统回收时进度也会落盘，回到 App 点「继续」可续传）。
          注意：API 34+ 不允许后台自行拉起前台服务，所有启动都必须由用户操作触发。
        -->
        <service
            android:name=".install.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          自更新安装包的 FileProvider：把应用专属目录里的 .apk 以 content:// 形式
          交给系统安装器（targetSdk 24+ 不允许直接 file:// 外发，会 FileUriExposedException）。
          exported=false + grantUriPermissions=true：只有我们临时授权的接收方能读。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>
