<!-- 精灵球：对应鸿蒙版 $r('app.media.pokeball')（首页下载/解压动画用）。
     纯矢量，不引任何位图资源；上红下白 + 中间黑带 + 中心按钮。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- 球体：上半红、下半白、中间黑带，全部裁进圆形里 -->
    <group>
        <clip-path android:pathData="M48,8 a40,40 0 1,0 0,80 a40,40 0 1,0 0,-80 z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,0 h96 v96 h-96 z" />
        <path
            android:fillColor="#E3350D"
            android:pathData="M0,0 h96 v48 h-96 z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M0,44 h96 v8 h-96 z" />
    </group>
    <!-- 中心按钮：白底 + 黑心 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,32 a16,16 0 1,0 0,32 a16,16 0 1,0 0,-32 z" />
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M48,39.5 a8.5,8.5 0 1,0 0,17 a8.5,8.5 0 1,0 0,-17 z" />
    <!-- 外圈描边 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="4"
        android:pathData="M48,8 a40,40 0 1,0 0,80 a40,40 0 1,0 0,-80 z" />
</vector>
